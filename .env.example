# Google AI API key — required for Gemini (LLM agents), Veo (video generation), and TTS (narration)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# OpenAI API key — OPTIONAL. Not required; TTS is handled by Google Cloud Text-to-Speech.
# Only needed if you revert to the OpenAI tts-1 model for narration synthesis.
# OPENAI_API_KEY="your_openai_api_key_here"
